<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CoreNFC 读 NDEF 标签所需。
	     ⚠️ 本工程产出的是未签名 .ipa（供 TrollStore 安装），
	     编译阶段不会把 entitlement 真正签进可执行文件。
	     需要 NFC 时，请在安装前用 ldid / codesign 注入，
	     并把 NFCManager.enabled 改为 true。默认关闭，避免点击即崩溃。 -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>NDEF</string>
	</array>
	<key>get-task-allow</key>
	<true/>
</dict>
</plist>
